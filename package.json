{
  "name": "tenlo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "directory:seed": "tsc -p tsconfig.seed.json && node .tmp/directory-seed/scripts/build-directory-seed.js",
    "directory:seed:write": "tsc -p tsconfig.seed.json && node .tmp/directory-seed/scripts/build-directory-seed.js --write supabase/seeds/0001_pilot_directory.sql",
    "directory:seed:check": "tsc -p tsconfig.seed.json && node .tmp/directory-seed/scripts/build-directory-seed.js --summary",
    "verify:migrations": "node scripts/verify-migrations.mjs",
    "verify:gtm": "node --use-system-ca scripts/verify-gtm-contract.mjs",
    "verify:ui": "node scripts/verify-ui-contracts.mjs",
    "verify:production": "node --use-system-ca scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.46.1",
    "@tailwindcss/postcss": "4.3.5",
    "lucide-react": "^0.468.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "postcss": "^8.5.29",
    "tailwindcss": "4.3.5",
    "typescript": "^5.6.3"
  }
}
