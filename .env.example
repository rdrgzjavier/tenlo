NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://tenlo.es
NEXT_PUBLIC_GTM_ID=

# Compatibilidad si el proyecto usa la anon key clasica.
